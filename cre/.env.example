# Copy to .env — never commit the real file.
# Key used by `cre workflow simulate --broadcast` to send the report transaction on Sepolia.
CRE_ETH_PRIVATE_KEY=
CRE_TARGET=staging-settings
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Etherscan V2 API key (verified source code lookup)
ETHERSCAN_API_KEY_VALUE=
