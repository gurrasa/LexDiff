# Claude API key for term extraction (server-side only)
ANTHROPIC_API_KEY=
# Deployed LexDiffRegistry on Sepolia (from contracts/deployments/11155111.json)
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_REGISTRY_DEPLOYMENT_BLOCK=12019746
# Base URL written into termsURI. The CRE workflow fetches terms from here; localhost works for `cre workflow simulate`.
PUBLIC_BASE_URL=http://localhost:3000
# Mount these directories on persistent storage in hosted environments (e.g. a Railway volume at /data).
EVIDENCE_DIR=
REGISTRATIONS_DIR=

# Lets the agreement page run the Chainlink CRE check locally (demo only, never on a hosted site)
ENABLE_LOCAL_CRE=false
# CRE_BIN=/Users/you/.cre/bin/cre

# Gasless signing: a funded Sepolia key that submits already-signed registrations and decisions.
# The signature decides who acted, so the relayer cannot change any decision. Leave empty to send from the user's wallet.
RELAYER_PRIVATE_KEY=
# Lets the contract picker check that a contract's source is verified on Etherscan (optional).
ETHERSCAN_API_KEY=

# Server-only. Generate separate random 32-byte hex secrets, never NEXT_PUBLIC.
LEXDIFF_SESSION_SECRET=
LEXDIFF_EVIDENCE_API_TOKEN=
# Per-instance metadata is for local testing; use durable shared storage in production.
EVIDENCE_METADATA_DIR=
